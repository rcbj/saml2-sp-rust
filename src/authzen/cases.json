{
  "about": "saml2-sp's own AuthZEN cases for the embedded Remote PEP (#40). Each case is a SAML sign-in (a SamlLogin), an Access and the answer the host must see. src/authzen_test.rs runs them offline through a local-mode ServiceProvider against a stub PDP serving these rows and the *.xml policies; scripts/live_authzen.py runs every case through a central and a local ServiceProvider against a fresh iya-sts and requires central == local == expect. The *.alfa files are what iya-sts is given; the *.xml files are what iya-sts stored for them (fetched from a live run, see docs/remote-pep.md).",
  "application": "the SP's entityId: the bound application",
  "supportedObligations": ["step-up"],
  "directory": {
    "azn-carol": {"cn": "Carol Ledger", "givenName": "Carol", "sn": "Ledger", "displayName": "Carol Ledger", "mail": "carol@saml-sp.test"}
  },
  "catalogue": [
    {"object": "subject", "property": "acr", "attributeId": "urn:saml-sp:acr"},
    {"object": "subject", "property": "clearance", "attributeId": "urn:saml-sp:clearance", "dataType": "integer"},
    {"object": "subject", "property": "team", "attributeId": "urn:saml-sp:team", "multiplicity": "bag"},
    {"object": "subject", "property": "contractor", "attributeId": "urn:saml-sp:contractor", "dataType": "boolean"},
    {"object": "resource", "property": "sensitivity", "attributeId": "urn:saml-sp:sensitivity", "category": "resource", "dataType": "double"},
    {"object": "resource", "property": "retainUntil", "attributeId": "urn:saml-sp:retain-until", "dataType": "dateTime"},
    {"object": "resource", "property": "owner.region", "attributeId": "urn:saml-sp:owner-region"},
    {"object": "resource", "property": "labels", "attributeId": "urn:saml-sp:label", "multiplicity": "bag"},
    {"object": "action", "property": "reason", "attributeId": "urn:saml-sp:reason", "category": "action"},
    {"object": "context", "property": "channel", "attributeId": "urn:saml-sp:channel", "category": "environment"},
    {"object": "context", "property": "device.managed", "attributeId": "urn:saml-sp:device-managed", "category": "urn:oasis:names:tc:xacml:3.0:attribute-category:environment", "dataType": "http://www.w3.org/2001/XMLSchema#boolean"}
  ],
  "policies": {
    "root": {"name": "saml-sp-authzen-root", "alfa": "root.alfa", "xacml": "root.xml", "kind": "PolicySet", "policyId": "urn:saml-sp:authzen:root"},
    "shared": {"name": "saml-sp-authzen-settlements", "alfa": "shared.alfa", "xacml": "shared.xml", "kind": "Policy", "policyId": "urn:saml-sp:authzen:settlements"},
    "application": {"alfa": "application.alfa", "xacml": "application.xml", "kind": "PolicySet", "policyId": "urn:saml-sp:authzen:application", "references": ["urn:saml-sp:authzen:settlements"]}
  },
  "phases": {
    "root": "the realm root decides: the application enforces no fine-grained authorization",
    "application": "the application enforces fine-grained authorization; its own policy (a PolicySet referencing the shared settlements policy) decides, never the root"
  },
  "logins": {
    "carol": {
      "nameId": "_azn-transient-1",
      "acr": "urn:oasis:names:tc:SAML:2.0:ac:classes:PasswordProtectedTransport",
      "attributes": {
        "urn:oid:0.9.2342.19200300.100.1.1": ["azn-carol"],
        "uid": ["azn-carol"],
        "urn:oid:0.9.2342.19200300.100.1.3": ["carol@saml-sp.test"],
        "displayName": ["Carol Ledger"],
        "clearance": ["4"],
        "team": ["staff", "legal"],
        "contractor": ["false"]
      },
      "friendlyNames": {"urn:oid:0.9.2342.19200300.100.1.1": "uid", "urn:oid:0.9.2342.19200300.100.1.3": "mail"}
    },
    "nobody": {
      "nameId": "_azn-transient-2",
      "acr": "urn:oasis:names:tc:SAML:2.0:ac:classes:PasswordProtectedTransport",
      "attributes": {"uid": ["azn-nobody"], "clearance": ["4"], "team": ["legal"], "contractor": ["false"]}
    }
  },
  "cases": [
    {"name": "permit: read with the acr the policy wants", "login": "carol",
     "access": {"action": "read", "type": "dossier", "id": "d-1"}, "expect": {"decision": "Permit"}},
    {"name": "deny: the policy's own deny for another acr", "login": "carol",
     "acr": "urn:oasis:names:tc:SAML:2.0:ac:classes:Password",
     "access": {"action": "read", "type": "dossier", "id": "d-1"}, "expect": {"decision": "Deny"}},
    {"name": "missing claim: no AuthnContextClassRef, so no acr", "login": "carol", "acr": "",
     "access": {"action": "read", "type": "dossier", "id": "d-1"}, "expect": {"decision": "Deny"}},
    {"name": "not applicable: a resource type no policy targets", "login": "carol",
     "access": {"action": "read", "type": "parcel", "id": "p-1"}, "expect": {"decision": "Deny"}},
    {"name": "integer: a SAML string reaches an integer row", "login": "carol",
     "access": {"action": "annotate", "type": "dossier", "id": "d-1"}, "expect": {"decision": "Permit"}},
    {"name": "integer: too low", "login": "carol", "attributes": {"clearance": ["2"]},
     "access": {"action": "annotate", "type": "dossier", "id": "d-1"}, "expect": {"decision": "Deny"}},
    {"name": "wrong type: a claim that is not an integer is refused", "login": "carol", "attributes": {"clearance": ["four"]},
     "access": {"action": "annotate", "type": "dossier", "id": "d-1"}, "expect": {"decision": "Deny"}},
    {"name": "friendly name: the claim under an OID Name, read by its FriendlyName", "login": "carol",
     "attributes": {"clearance": null, "urn:oid:1.3.6.1.4.1.55555.7": ["5"]}, "friendlyNames": {"urn:oid:1.3.6.1.4.1.55555.7": "clearance"},
     "access": {"action": "annotate", "type": "dossier", "id": "d-1"}, "expect": {"decision": "Permit"}},
    {"name": "double and dateTime: typed resource properties", "login": "carol",
     "access": {"action": "archive", "type": "dossier", "id": "d-2", "resource": {"sensitivity": 0.25, "retainUntil": "2027-03-01T00:00:00Z"}},
     "expect": {"decision": "Permit"}},
    {"name": "double: a string that parses at the row's type", "login": "carol",
     "access": {"action": "archive", "type": "dossier", "id": "d-2", "resource": {"sensitivity": "0.25", "retainUntil": "2027-03-01T00:00:00Z"}},
     "expect": {"decision": "Permit"}},
    {"name": "double: above the limit", "login": "carol",
     "access": {"action": "archive", "type": "dossier", "id": "d-2", "resource": {"sensitivity": 0.75, "retainUntil": "2027-03-01T00:00:00Z"}},
     "expect": {"decision": "Deny"}},
    {"name": "wrong type: a double that does not parse is refused", "login": "carol",
     "access": {"action": "archive", "type": "dossier", "id": "d-2", "resource": {"sensitivity": "low", "retainUntil": "2027-03-01T00:00:00Z"}},
     "expect": {"decision": "Deny"}},
    {"name": "wrong type: a dateTime that does not parse is refused", "login": "carol",
     "access": {"action": "archive", "type": "dossier", "id": "d-2", "resource": {"sensitivity": 0.25, "retainUntil": "next spring"}},
     "expect": {"decision": "Deny"}},
    {"name": "bag and nested path: the team bag and owner.region", "login": "carol",
     "access": {"action": "share", "type": "dossier", "id": "d-3", "resource": {"owner": {"region": "emea"}}}, "expect": {"decision": "Permit"}},
    {"name": "bag: one SAML value reaches a bag row", "login": "carol", "attributes": {"team": ["legal"]},
     "access": {"action": "share", "type": "dossier", "id": "d-3", "resource": {"owner": {"region": "emea"}}}, "expect": {"decision": "Permit"}},
    {"name": "bag: not in the team", "login": "carol", "attributes": {"team": ["staff", "sales"]},
     "access": {"action": "share", "type": "dossier", "id": "d-3", "resource": {"owner": {"region": "emea"}}}, "expect": {"decision": "Deny"}},
    {"name": "nested path: another region", "login": "carol",
     "access": {"action": "share", "type": "dossier", "id": "d-3", "resource": {"owner": {"region": "apac"}}}, "expect": {"decision": "Deny"}},
    {"name": "nested path: an undeclared sibling member is refused", "login": "carol",
     "access": {"action": "share", "type": "dossier", "id": "d-3", "resource": {"owner": {"region": "emea", "city": "Paris"}}}, "expect": {"decision": "Deny"}},
    {"name": "resource bag and an action property", "login": "carol",
     "access": {"action": "hold", "type": "dossier", "id": "d-4", "resource": {"labels": ["archive", "litigation"]}, "actionProperties": {"reason": "court-order"}},
     "expect": {"decision": "Permit"}},
    {"name": "null is refused", "login": "carol",
     "access": {"action": "hold", "type": "dossier", "id": "d-4", "resource": {"labels": null}, "actionProperties": {"reason": "court-order"}},
     "expect": {"decision": "Deny"}},
    {"name": "context members: channel and the nested device.managed", "login": "carol",
     "access": {"action": "export", "type": "dossier", "id": "d-5", "context": {"channel": "branch", "device": {"managed": true}}}, "expect": {"decision": "Permit"}},
    {"name": "boolean: the string true parses at a boolean row", "login": "carol",
     "access": {"action": "export", "type": "dossier", "id": "d-5", "context": {"channel": "branch", "device": {"managed": "true"}}}, "expect": {"decision": "Permit"}},
    {"name": "wrong type: a number at a boolean row is refused", "login": "carol",
     "access": {"action": "export", "type": "dossier", "id": "d-5", "context": {"channel": "branch", "device": {"managed": 1}}}, "expect": {"decision": "Deny"}},
    {"name": "wrong type: an array at a single row is refused", "login": "carol",
     "access": {"action": "export", "type": "dossier", "id": "d-5", "context": {"channel": ["branch"], "device": {"managed": true}}}, "expect": {"decision": "Deny"}},
    {"name": "boolean claim: a contractor", "login": "carol", "attributes": {"contractor": ["true"]},
     "access": {"action": "export", "type": "dossier", "id": "d-5", "context": {"channel": "branch", "device": {"managed": true}}}, "expect": {"decision": "Deny"}},
    {"name": "wrong type: a boolean claim that does not parse is refused", "login": "carol", "attributes": {"contractor": ["yes"]},
     "access": {"action": "export", "type": "dossier", "id": "d-5", "context": {"channel": "branch", "device": {"managed": true}}}, "expect": {"decision": "Deny"}},
    {"name": "undeclared resource property: refused", "login": "carol",
     "access": {"action": "read", "type": "dossier", "id": "d-1", "resource": {"colour": "red"}}, "expect": {"decision": "Deny"}},
    {"name": "undeclared context member: refused", "login": "carol",
     "access": {"action": "read", "type": "dossier", "id": "d-1", "context": {"weather": "rain"}}, "expect": {"decision": "Deny"}},
    {"name": "undeclared claim: dropped, so the policy never sees it", "login": "carol", "attributes": {"department": ["finance"]},
     "access": {"action": "budget", "type": "dossier", "id": "d-6"}, "expect": {"decision": "Deny"}},
    {"name": "undeclared claim named as the XACML id: still dropped", "login": "carol", "attributes": {"urn:saml-sp:department": ["finance"]},
     "access": {"action": "budget", "type": "dossier", "id": "d-6"}, "expect": {"decision": "Deny"}},
    {"name": "context.application naming another application: the PEP keeps its own", "login": "carol",
     "access": {"action": "read", "type": "dossier", "id": "d-1", "context": {"application": "https://elsewhere.saml-sp.test/app"}}, "expect": {"decision": "Permit"}},
    {"name": "directory attribute: sn from the PIP", "login": "carol",
     "access": {"action": "audit", "type": "dossier", "id": "d-7"}, "expect": {"decision": "Permit"}},
    {"name": "directory attribute: a person the directory does not hold", "login": "nobody",
     "access": {"action": "audit", "type": "dossier", "id": "d-7"}, "expect": {"decision": "Deny"}},
    {"name": "trusted fact: the protocol is authzen", "login": "carol",
     "access": {"action": "inspect", "type": "dossier", "id": "d-8"}, "expect": {"decision": "Permit"}},
    {"name": "a processing error is no decision", "login": "carol",
     "access": {"action": "tally", "type": "dossier", "id": "d-8"}, "expect": {"decision": "Unavailable"}},
    {"name": "obligation the host declared: handed under the Obligations Profile", "login": "carol",
     "access": {"action": "approve", "type": "dossier", "id": "d-9"},
     "expect": {"decision": "Permit", "obligations": [{"type": "step-up", "properties": {"acr_value": "urn:saml-sp:acr:two-factor"}}]}},
    {"name": "obligation the host did not declare: a Deny", "login": "carol",
     "access": {"action": "notify", "type": "dossier", "id": "d-9"}, "expect": {"decision": "Deny"}},
    {"name": "the log obligation is discharged by the PDP side", "login": "carol",
     "access": {"action": "list", "type": "dossier", "id": "d-9"}, "expect": {"decision": "Permit"}},
    {"name": "decide_session: a tracked session is asked", "login": "carol", "session": "tracked",
     "access": {"action": "read", "type": "dossier", "id": "d-1"}, "expect": {"decision": "Permit"}},
    {"name": "decide_session: an ended session is a Deny without asking", "login": "carol", "session": "ended",
     "access": {"action": "read", "type": "dossier", "id": "d-1"}, "expect": {"decision": "Deny"}},
    {"name": "fga: the application's own rule", "phase": "application", "login": "carol",
     "access": {"action": "view", "type": "invoice", "id": "i-1"}, "expect": {"decision": "Permit"}},
    {"name": "fga: a rule in the policy the application's policy references", "phase": "application", "login": "carol",
     "access": {"action": "settle", "type": "invoice", "id": "i-1"}, "expect": {"decision": "Permit"}},
    {"name": "fga: a rule on the stage the service adds for an application's policy", "phase": "application", "login": "carol",
     "access": {"action": "pay", "type": "invoice", "id": "i-1"}, "expect": {"decision": "Permit"}},
    {"name": "fga: nothing permits", "phase": "application", "login": "carol",
     "access": {"action": "delete", "type": "invoice", "id": "i-1"}, "expect": {"decision": "Deny"}},
    {"name": "fga: the root is not consulted", "phase": "application", "login": "carol",
     "access": {"action": "read", "type": "dossier", "id": "d-1"}, "expect": {"decision": "Deny"}}
  ]
}
